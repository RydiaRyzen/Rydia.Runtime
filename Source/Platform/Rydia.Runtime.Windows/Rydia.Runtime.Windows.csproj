<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
	  <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Rydia</RootNamespace>

	  <!-- 署名を有効にする構成 -->
	  <EnableCodeSigning Condition="'$(Configuration)' == 'Release'">true</EnableCodeSigning>

	  <!-- SignTool.exe のパスは環境に合わせて設定 -->
	  <SignToolPath Condition="'$(SignToolPath)' == ''">C:\Program Files (x86)\Microsoft SDKs\ClickOnce\SignTool\signtool.exe</SignToolPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\Rydia.Runtime\Rydia.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenTK">
      <HintPath>..\..\..\Redist\Windows\OpenTK.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="x64\d3dcompiler_47.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\libEGL.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\libGLESv2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\openal32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x86\d3dcompiler_47.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x86\libEGL.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x86\libGLESv2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x86\openal32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\..\Runtime\Api\Rydia.Audio.Api.NVorbis\Rydia.Audio.Api.NVorbis.projitems" Label="Shared" />

  <Import Project="..\..\Runtime\Api\Rydia.Audio.Api.OpenAL\Rydia.Audio.Api.OpenAL.projitems" Label="Shared" />

  <Import Project="..\..\Runtime\Api\Rydia.Graphics.Api.ES30\Rydia.Graphics.Api.ES20.projitems" Label="Shared" />

  <Import Project="..\..\Runtime\Api\Rydia.Graphics.Api.ES30.OpenTKBindings\Rydia.Graphics.Api.ES30.OpenTKBindings.projitems" Label="Shared" />
	<Target Name="SignReleaseOutput"
			AfterTargets="Build"
			Condition="'$(Configuration)' == 'Release'
                   and '$(TargetExt)' == '.dll'
                   and '$(EnableCodeSigning)' == 'true'">

		<Error Condition="!Exists('$(SignToolPath)')"
			   Text="SignTool.exe が見つかりません: $(SignToolPath)" />

		<Error Condition="!Exists('$(TargetPath)')"
			   Text="署名対象が見つかりません: $(TargetPath)" />

		<Exec Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /tr http://timestamp.digicert.com /td SHA256 /a /v &quot;$(TargetPath)&quot;" />

		<Exec Command="&quot;$(SignToolPath)&quot; verify /pa /v &quot;$(TargetPath)&quot;" />

	</Target>
</Project>
